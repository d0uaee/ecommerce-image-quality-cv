"""
Multi-criteria image quality analyser for e-commerce product images.

Each criterion returns a sub-dict:
    { "score": float[0,1], "value": <raw measurement>, "message": str }

Usage
-----
from src.analyzer import analyze_image, global_score

report = analyze_image("data/raw_images/electronics/001_phone.jpg")
print(global_score(report["criteria"]))   # e.g. 0.74
"""

from __future__ import annotations

import logging
from pathlib import Path
from typing import Union

import cv2
import numpy as np
from PIL import Image, UnidentifiedImageError

log = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Criterion weights for the global score
# ---------------------------------------------------------------------------

WEIGHTS = {
    "blur":             0.20,
    "brightness":       0.15,
    "white_background": 0.25,
    "centering":        0.15,
    "product_ratio":    0.20,
    "watermark":        0.05,
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _load_image(image_path: Union[str, Path]) -> np.ndarray | None:
    """Return an RGB uint8 numpy array, or None on failure."""
    try:
        img = Image.open(image_path).convert("RGB")
        return np.array(img)
    except FileNotFoundError:
        log.error("Image not found: %s", image_path)
    except UnidentifiedImageError:
        log.error("Cannot identify image (corrupt?): %s", image_path)
    except Exception as exc:
        log.error("Unexpected error opening %s: %s", image_path, exc)
    return None


def _linear(value: float, low: float, high: float) -> float:
    """Linearly map value → [0, 1] clamped, where high maps to 1."""
    if value <= low:
        return 0.0
    if value >= high:
        return 1.0
    return (value - low) / (high - low)


def _criterion(score: float, value, message: str) -> dict:
    return {"score": round(float(score), 4), "value": value, "message": message}


# ---------------------------------------------------------------------------
# Individual criteria
# ---------------------------------------------------------------------------

def _blur(gray_product: np.ndarray) -> dict:
    """
    Laplacian variance on the product region.
    Score 1.0 if variance > 500, 0.0 if < 50.
    """
    if gray_product.size == 0:
        return _criterion(0.0, 0.0, "No product region")

    variance = float(cv2.Laplacian(gray_product, cv2.CV_64F).var())
    score = _linear(variance, 50.0, 500.0)

    if score >= 0.8:
        msg = "Sharp image"
    elif score >= 0.4:
        msg = "Slightly blurry"
    else:
        msg = "Blurry image"

    return _criterion(score, round(variance, 2), msg)


def _brightness(hsv_product: np.ndarray) -> dict:
    """
    Mean V-channel in product region.
    Score 1.0 in [120, 200]; decreases linearly outside.
    """
    if hsv_product.size == 0:
        return _criterion(0.0, 0.0, "No product region")

    # hsv_product may be (N, 3) from boolean mask indexing or (N, 1, 3) from unit tests
    arr = np.asarray(hsv_product)
    if arr.ndim == 3:
        v_channel = arr[:, :, 2].astype(float)
    else:
        v_channel = arr[:, 2].astype(float)
    mean_v = float(v_channel.mean())

    # Piecewise: 0 at extremes (0, 255), peak at [120, 200]
    if 120.0 <= mean_v <= 200.0:
        score = 1.0
    elif mean_v < 120.0:
        score = _linear(mean_v, 0.0, 120.0)
    else:  # > 200
        score = _linear(255.0 - mean_v, 0.0, 55.0)   # 255-200=55

    if score >= 0.8:
        msg = "Good brightness"
    elif mean_v < 120.0:
        msg = "Too dark"
    else:
        msg = "Overexposed"

    return _criterion(score, round(mean_v, 2), msg)


def _white_background(hsv_full: np.ndarray, mask: np.ndarray) -> dict:
    """
    Ratio of near-white pixels (S<30, V>200) in the background region.
    """
    h, w = hsv_full.shape[:2]
    bg_mask = (mask == 0)
    total_bg = int(bg_mask.sum())

    if total_bg == 0:
        return _criterion(1.0, 1.0, "No background (product fills frame)")

    s_channel = hsv_full[:, :, 1]
    v_channel = hsv_full[:, :, 2]

    near_white = (s_channel < 30) & (v_channel > 200)
    white_bg_count = int((near_white & bg_mask).sum())
    ratio = white_bg_count / total_bg

    score = ratio
    msg = "White background" if ratio >= 0.6 else "Non-white background"
    return _criterion(score, round(ratio, 4), msg)


def _centering(mask: np.ndarray) -> dict:
    """
    Euclidean distance between product centroid and image centre,
    normalised by image diagonal.
    Score 1.0 if < 5 %, 0.0 if > 30 %.
    """
    h, w = mask.shape
    diagonal = np.sqrt(h ** 2 + w ** 2)
    cx_img, cy_img = w / 2.0, h / 2.0

    coords = cv2.findNonZero(mask)
    if coords is None:
        return _criterion(0.0, 1.0, "No product region")

    cx_prod = float(coords[:, 0, 0].mean())
    cy_prod = float(coords[:, 0, 1].mean())

    dist = np.sqrt((cx_prod - cx_img) ** 2 + (cy_prod - cy_img) ** 2)
    norm_dist = dist / diagonal

    # score: 1.0 at 0.05, 0.0 at 0.30, linear between
    score = 1.0 - _linear(norm_dist, 0.05, 0.30)
    score = max(0.0, min(1.0, score))

    if score >= 0.8:
        msg = "Well centered"
    elif score >= 0.4:
        msg = "Slightly off-center"
    else:
        msg = "Poorly centered"

    return _criterion(score, round(norm_dist, 4), msg)


def _product_ratio(mask: np.ndarray) -> dict:
    """
    Product mask area / total image area.
    Score 1.0 in [0.4, 0.8]; linear ramp up from 0 and down to 1.
    """
    h, w = mask.shape
    total = h * w
    product_area = int((mask > 0).sum())
    ratio = product_area / total if total > 0 else 0.0

    if 0.15 <= ratio <= 0.8:
        score = 1.0
    elif ratio < 0.15:
        score = _linear(ratio, 0.0, 0.15)
    else:  # > 0.8
        score = _linear(1.0 - ratio, 0.0, 0.2)   # 1.0-0.8=0.2

    if score >= 0.8:
        msg = "Good product size"
    elif ratio < 0.15:
        msg = "Product too small"
    else:
        msg = "Product too large"

    return _criterion(score, round(ratio, 4), msg)


def _watermark(gray_full: np.ndarray) -> dict:
    """
    Edge density (Canny) in the 4 corners (each 10 % of image dimensions).
    High edge density in corners suggests watermark/logo overlays.
    Score 1.0 if max density < 0.05, 0.0 if > 0.20.
    """
    h, w = gray_full.shape
    ch = max(1, int(h * 0.10))
    cw = max(1, int(w * 0.10))

    corners = [
        gray_full[:ch, :cw],          # top-left
        gray_full[:ch, w - cw:],      # top-right
        gray_full[h - ch:, :cw],      # bottom-left
        gray_full[h - ch:, w - cw:],  # bottom-right
    ]

    max_density = 0.0
    for corner in corners:
        edges = cv2.Canny(corner, 50, 150)
        density = float(edges.sum() / 255) / max(1, corner.size)
        max_density = max(max_density, density)

    # Score: 1.0 if clean (< 0.05), 0.0 if heavy (> 0.20)
    score = 1.0 - _linear(max_density, 0.05, 0.20)
    score = max(0.0, min(1.0, score))

    msg = "No watermark detected" if score >= 0.6 else "Possible watermark detected"
    return _criterion(score, round(max_density, 6), msg)


# ---------------------------------------------------------------------------
# Main analysis function
# ---------------------------------------------------------------------------

def analyze(
    image_path: Union[str, Path],
    detection: dict,
) -> dict:
    """
    Analyse image quality given a pre-computed detection result.

    Parameters
    ----------
    image_path : path to the image file
    detection  : dict returned by ``detect_product()``

    Returns
    -------
    dict with keys:
        "criteria" : dict of criterion_name → {score, value, message}
        "success"  : bool (False if image could not be loaded)
    """
    image_path = Path(image_path)
    img_rgb = _load_image(image_path)

    if img_rgb is None:
        empty = {k: _criterion(0.0, None, "Image load failed") for k in WEIGHTS}
        return {"criteria": empty, "success": False}

    h, w = img_rgb.shape[:2]
    mask = detection.get("mask", np.zeros((h, w), dtype=np.uint8))

    # Resize mask if dimensions mismatch (e.g. from a different load path)
    if mask.shape != (h, w):
        mask = cv2.resize(mask, (w, h), interpolation=cv2.INTER_NEAREST)

    # Pre-compute colour-space conversions once
    gray_full = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2GRAY)
    hsv_full  = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2HSV)

    # Masked (product-only) versions
    fg = mask > 0
    gray_product = gray_full[fg] if fg.any() else np.array([], dtype=np.uint8)
    hsv_product  = hsv_full[fg]  if fg.any() else np.zeros((0, 1, 3), dtype=np.uint8)

    criteria = {
        "blur":             _blur(gray_product),
        "brightness":       _brightness(hsv_product),
        "white_background": _white_background(hsv_full, mask),
        "centering":        _centering(mask),
        "product_ratio":    _product_ratio(mask),
        "watermark":        _watermark(gray_full),
    }

    return {"criteria": criteria, "success": True}


def analyze_image(image_path: Union[str, Path]) -> dict:
    """
    Convenience wrapper: runs ``detect_product()`` internally, then analyses.

    Returns the same dict as ``analyze()``, plus the detection result under
    the key ``"detection"``.
    """
    from src.detector import detect_product  # local import to avoid circular deps

    image_path = Path(image_path)
    detection = detect_product(image_path)
    result = analyze(image_path, detection)
    result["detection"] = detection
    return result


# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------

def global_score(criteria: dict) -> float:
    """
    Weighted average of criterion scores.

    Parameters
    ----------
    criteria : the ``"criteria"`` sub-dict from ``analyze()`` / ``analyze_image()``

    Returns
    -------
    float in [0, 1]
    """
    total_weight = 0.0
    weighted_sum = 0.0
    for name, weight in WEIGHTS.items():
        criterion = criteria.get(name)
        if criterion is None:
            continue
        weighted_sum += criterion["score"] * weight
        total_weight += weight
    return round(weighted_sum / total_weight, 4) if total_weight > 0 else 0.0


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    import sys
    import json

    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")

    if len(sys.argv) < 2:
        print("Usage: python -m src.analyzer <image_path>")
        sys.exit(1)

    report = analyze_image(sys.argv[1])
    criteria = report["criteria"]

    print(f"\n{'Criterion':<20} {'Score':>6}  {'Value':>10}  Message")
    print("-" * 65)
    for name, data in criteria.items():
        print(f"{name:<20} {data['score']:>6.3f}  {str(data['value']):>10}  {data['message']}")

    score = global_score(criteria)
    print("-" * 65)
    print(f"{'GLOBAL SCORE':<20} {score:>6.3f}")
